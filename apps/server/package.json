{
  "name": "@cheongiwa/server",
  "version": "0.1.0",
  "description": "청기와 게임 서버 — Fastify(정적 서빙·헬스체크) + Socket.IO, 서버 권위 구조",
  "type": "module",
  "private": true,
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.cjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@cheongiwa/engine": "workspace:*",
    "@cheongiwa/protocol": "workspace:*",
    "@fastify/static": "^8.0.3",
    "fastify": "^5.2.0",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5"
  }
}
